# Application Configuration
APP_ENV=production
SECRET_KEY=generate_a_random_32_byte_hex_string
ENCRYPTION_KEY=
PORT=8000

# Browser Control Options
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
BROWSER_FAST_MODE=false
BROWSER_REAL_MOUSE=false

# Model Defaults
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434

# Cloud Providers (Optional - can also be configured securely in UI)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
