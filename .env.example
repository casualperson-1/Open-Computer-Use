# ---------------------------------------------------------------------------
# Open Computer Use server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8765
OPEN_COMPUTER_USE_DATA_DIR=./data
APP_ENV=production

# The first account is the owner/administrator. Create it from the server's
# terminal (password prompt, no echo):
#   python -m server.cli create-owner
# Automated installs: --password-env VAR or --password-file /run/secrets/owner
#
# Everyone else signs up on the login screen. open (default) = anyone who can
# reach this server can create an account; each account stores its own provider
# key. invite = single-use codes from `python -m server.cli create-invite` or
# Admin → Invites. closed = no signup at all.
SIGNUP_MODE=open
INVITE_TTL_HOURS=72
# Per-member limits: runs per hour and optional daily spend cap in USD.
USER_RUN_LIMIT_PER_HOUR=30
# USER_USAGE_CAP_USD=2.0
#
# Binding to anything other than loopback requires BOTH an existing owner and
# this explicit opt-in. The default (HOST above) is loopback only.
ALLOW_REMOTE_BIND=false

# Public https origin when a proxy/tunnel terminates TLS (Tailscale Funnel,
# Cloudflare Tunnel, Twingate, Caddy). Used for Origin checks and Secure cookies.
# Behind Tailscale Funnel also set TRUSTED_PROXIES=127.0.0.1/32.
# PUBLIC_BASE_URL=https://agent.example.com

# Comma-separated CIDRs whose X-Forwarded-For/Proto headers are trusted.
# Empty = trust none; the socket peer address is used instead.
# TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8,fd00::/8

# Stable secret for CSRF tokens and session hashing. Required for sessions to
# survive a restart. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Login protection: failures inside the window trigger an exponential lockout,
# applied per IP, per username and globally.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_BASE_SECONDS=5
LOGIN_LOCKOUT_MAX_SECONDS=900
SESSION_TTL_HOURS=168

# Where `python -m server.cli backup` writes archives (database + Fernet key).
BACKUP_DIR=./backups

# desktop = real mouse/keyboard, simulated = safe virtual desktop
COMPUTER=desktop
SCREEN_MAX_WIDTH=1280
HUMAN_MOUSE=true
MAX_STEPS=30
MAX_COST=1.0

# auto = act without asking, confirm = approve every action
APPROVAL_MODE=auto

# Optional: link shown in the UI for a noVNC virtual desktop (Docker mode)
VNC_URL=

# Provider keys are encrypted with this Fernet key. Set exactly one of:
#   ENCRYPTION_KEY      32-byte urlsafe base64 key
#   ENCRYPTION_KEY_FILE mounted secret file (mode 600), e.g. /run/secrets/fernet
# If neither is set, .fernet.key inside OPEN_COMPUTER_USE_DATA_DIR is used and
# created on first start. Back the key up with the database: `python -m server.cli
# backup` stores both; `restore` refuses a mismatched pair. A missing or invalid
# configured key stops startup instead of silently creating a new one.
ENCRYPTION_KEY=
# ENCRYPTION_KEY_FILE=/run/secrets/fernet

# ---------------------------------------------------------------------------
# Model defaults
# ---------------------------------------------------------------------------
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=
MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# BYOK keys (optional: you can also save keys in the web UI)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Ollama runs locally and needs no key
OLLAMA_BASE_URL=http://localhost:11434

# Any OpenAI-compatible endpoint (OpenRouter, Groq, vLLM, LM Studio, ...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_VISION=true

# Optional endpoint overrides for OpenAI / Anthropic / Gemini / DeepSeek
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
# DEEPSEEK_BASE_URL=

# ---------------------------------------------------------------------------
# Desktop nodes (server side)
# Real mouse, keyboard and browser control runs on a node that dials out to
# this server over wss://. The server never opens a port on the node.
# required = desktop runs use this user's own node and fail without one
# auto = fall back to the simulated desktop for the administrator only
# never = always use the simulated desktop (administrator)
# Non-admin members never fall back: the server's own desktop is off limits.
# ---------------------------------------------------------------------------
REMOTE_NODE_MODE=required
NODE_COMMAND_TIMEOUT=45

# Server-side policy for commands sent to a node. The node has its own,
# independent rules; a command must pass both. Comma-separated glob patterns;
# an empty allow list permits everything of that kind and deny lists win.
NODE_ALLOWED_COMMANDS=
NODE_DENIED_COMMANDS=
NODE_ALLOWED_DOMAINS=
NODE_DENIED_DOMAINS=
NODE_ALLOWED_APPS=
NODE_DENIED_APPS=

# Commands per minute per desktop run (0 disables the limit)
NODE_RATE_LIMIT=240

# off = never ask, risky = ask for NODE_APPROVAL_COMMANDS, all = ask always
NODE_APPROVAL_MODE=off
NODE_APPROVAL_COMMANDS=open_item,open_url,browser_action,key_combo
NODE_APPROVAL_TIMEOUT=120

# Write audit rows for node commands, enrolment and connection changes
NODE_AUDIT=true

# ---------------------------------------------------------------------------
# Node machine only — set these on the machine being controlled, not on the
# server. Create the token in the server UI (Nodes) and keep it secret.
# ---------------------------------------------------------------------------
# OCC_NODE_SERVER=https://agent.example.com
# OCC_NODE_TOKEN=
# OCC_NODE_NAME=desk
# OCC_NODE_BACKEND=desktop
# OCC_NODE_DATA_DIR=./node-data
# OCC_NODE_CONTROL_PORT=8791
# OCC_NODE_HEARTBEAT=15
# OCC_NODE_HUMAN_MOUSE=true
# OCC_NODE_BROWSER_PROFILE=./node-data/browser_profile
#
# Optional node policy (allowlists, rate limit, audit). A JSON file:
#   OCC_NODE_POLICY=~/.config/occ/policy.json
# or individual variables, which override the file:
# OCC_NODE_ALLOWED_COMMANDS=mouse_move,click,scroll,type,screenshot,open_url
# OCC_NODE_DENIED_DOMAINS=*.bank.example
# OCC_NODE_ALLOWED_APPS=firefox,org.gnome.Nautilus
# OCC_NODE_RATE_LIMIT=120
# OCC_NODE_AUDIT=true
# OCC_NODE_INDICATOR=true

# ---------------------------------------------------------------------------
# Docker Compose (see docs/docker.md)
# Compose reads `.env` in this directory. Do NOT put SECRET_KEY or provider
# keys here: they are mounted as read-only files from deploy/secrets/, which
# deploy/generate-secrets.sh creates.
# ---------------------------------------------------------------------------
# Only Caddy publishes a port, and only on loopback by default.
PROXY_BIND=127.0.0.1
PROXY_PORT=8080
# SIGNUP_MODE, REMOTE_NODE_MODE and PUBLIC_BASE_URL above also apply to compose.

# Must match the compose network CIDR, because Caddy is the only proxy.
TRUSTED_PROXIES=172.28.0.0/24

# ---------------------------------------------------------------------------
# Remote access (docs/remote-access.md)
# ---------------------------------------------------------------------------
# Cloudflare Tunnel: create the token secret once, then start the profile.
#   read -rs CF_TUNNEL_TOKEN && printf '%s' "$CF_TUNNEL_TOKEN" \
#     | install -m 0444 /dev/stdin deploy/secrets/cf_tunnel_token
#   docker compose --profile cloudflared up -d
#
# Twingate connector: network name is not secret; tokens are files.
#   read -rs TWINGATE_ACCESS_TOKEN; read -rs TWINGATE_REFRESH_TOKEN
#   docker compose --profile twingate up -d
TWINGATE_NETWORK=
TWINGATE_LOG_LEVEL=3

# Local tunnel simulation only: never publish this port beyond loopback.
TUNNEL_SIM_PORT=8090

# backup sidecar interval in seconds (default 24h)
BACKUP_INTERVAL=86400

# Optional legacy desktop profile ports (bound to 127.0.0.1)
DESKTOP_WEB_PORT=8765
DESKTOP_VNC_PORT=6080
