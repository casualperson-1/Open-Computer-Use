# ---------------------------------------------------------------------------
# Open Computer Use server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8765
OPEN_COMPUTER_USE_DATA_DIR=./data
APP_ENV=production

# First-run owner signup is local-only by default. Enable only when the app is
# bound to localhost or protected by a trusted network boundary.
ALLOW_REMOTE_SIGNUP=false

# Optional stable secret for deriving CSRF tokens across restarts. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# desktop = real mouse/keyboard, simulated = safe virtual desktop
COMPUTER=desktop
SCREEN_MAX_WIDTH=1280
HUMAN_MOUSE=true
MAX_STEPS=30
MAX_COST=1.0

# auto = act without asking, confirm = approve every action
APPROVAL_MODE=auto

# Optional: link shown in the UI for a noVNC virtual desktop (Docker mode)
VNC_URL=

# Optional: 32-byte urlsafe base64 Fernet key. If empty, Open Computer Use
# creates .fernet.key inside OPEN_COMPUTER_USE_DATA_DIR and encrypts saved
# provider keys with it.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Model defaults
# ---------------------------------------------------------------------------
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=
MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# BYOK keys (optional: you can also save keys in the web UI)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Ollama runs locally and needs no key
OLLAMA_BASE_URL=http://localhost:11434

# Any OpenAI-compatible endpoint (OpenRouter, Groq, vLLM, LM Studio, ...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_VISION=true

# Optional endpoint overrides for OpenAI / Anthropic / Gemini / DeepSeek
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
# DEEPSEEK_BASE_URL=

# ---------------------------------------------------------------------------
# Desktop nodes (server side)
# Real mouse, keyboard and browser control runs on a node that dials out to
# this server over wss://. The server never opens a port on the node.
# auto = use a connected node and fall back to the simulated desktop
# required = refuse desktop runs when no node is connected
# never = always use the simulated desktop
# ---------------------------------------------------------------------------
REMOTE_NODE_MODE=auto
NODE_COMMAND_TIMEOUT=45

# Server-side policy for commands sent to a node. The node has its own,
# independent rules; a command must pass both. Comma-separated glob patterns;
# an empty allow list permits everything of that kind and deny lists win.
NODE_ALLOWED_COMMANDS=
NODE_DENIED_COMMANDS=
NODE_ALLOWED_DOMAINS=
NODE_DENIED_DOMAINS=
NODE_ALLOWED_APPS=
NODE_DENIED_APPS=

# Commands per minute per desktop run (0 disables the limit)
NODE_RATE_LIMIT=240

# off = never ask, risky = ask for NODE_APPROVAL_COMMANDS, all = ask always
NODE_APPROVAL_MODE=off
NODE_APPROVAL_COMMANDS=open_item,open_url,browser_action,key_combo
NODE_APPROVAL_TIMEOUT=120

# Write audit rows for node commands, enrolment and connection changes
NODE_AUDIT=true

# ---------------------------------------------------------------------------
# Node machine only — set these on the machine being controlled, not on the
# server. Create the token in the server UI (Nodes) and keep it secret.
# ---------------------------------------------------------------------------
# OCC_NODE_SERVER=https://agent.example.com
# OCC_NODE_TOKEN=
# OCC_NODE_NAME=desk
# OCC_NODE_BACKEND=desktop
# OCC_NODE_DATA_DIR=./node-data
# OCC_NODE_CONTROL_PORT=8791
# OCC_NODE_HEARTBEAT=15
# OCC_NODE_HUMAN_MOUSE=true
# OCC_NODE_BROWSER_PROFILE=./node-data/browser_profile
#
# Optional node policy (allowlists, rate limit, audit). A JSON file:
#   OCC_NODE_POLICY=~/.config/occ/policy.json
# or individual variables, which override the file:
# OCC_NODE_ALLOWED_COMMANDS=mouse_move,click,scroll,type,screenshot,open_url
# OCC_NODE_DENIED_DOMAINS=*.bank.example
# OCC_NODE_ALLOWED_APPS=firefox,org.gnome.Nautilus
# OCC_NODE_RATE_LIMIT=120
# OCC_NODE_AUDIT=true
# OCC_NODE_INDICATOR=true
