{
    admin off
    auto_https off
}

:80 {
    # Forward API and static dashboard
    handle_path /api/* {
        reverse_proxy app:8000
    }

    handle /ws/* {
        reverse_proxy app:8000
    }

    # Reverse proxy noVNC web interface and websockets
    handle /vnc/* {
        uri strip_prefix /vnc
        reverse_proxy browser:6080
    }

    handle /websockify* {
        reverse_proxy browser:6080
    }

    handle {
        reverse_proxy app:8000
    }
}
