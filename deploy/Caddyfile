{
    admin off
    auto_https off
}

:80 {
    # Open Computer Use dashboard, API and WebSocket
    handle /api/* {
        reverse_proxy open-computer-use:8765
    }

    handle /ws {
        reverse_proxy open-computer-use:8765
    }

    handle /ws/* {
        reverse_proxy open-computer-use:8765
    }

    # noVNC virtual desktop (manual takeover)
    handle /vnc/* {
        uri strip_prefix /vnc
        reverse_proxy open-computer-use:6080
    }

    handle /websockify* {
        reverse_proxy open-computer-use:6080
    }

    handle {
        reverse_proxy open-computer-use:8765
    }
}
